// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`toPortableMermaid > generates classDef / class / style / linkStyle lines from the resolved styles 1`] = `
"flowchart LR
  subgraph G [Group]
    A[Plain] --> B[(Store)]
    C{Choice} -.-> D[Hot]
  end
  subgraph H [Bare]
    E[Own] ==> F[Picked]
  end
  A -->|label| C
  F --- A
  class D hot

%% ---- generated by diagram-studio (portable styles) ----
style E fill:#d4e63a,stroke:#123456,stroke-width:1.6px,color:#1f1f1f
classDef studioDefault fill:#ffffff,stroke:#1f1f1f,stroke-width:1.6px,color:#1f1f1f
class A studioDefault
classDef s_db fill:#ffffff,stroke:#1f1f1f,stroke-width:1.3px,color:#1f1f1f
class B s_db
classDef s_decision fill:#fff4b8,stroke:#1f1f1f,stroke-width:1.6px,color:#1f1f1f
class C s_decision
classDef s_hot fill:#d0312d,stroke:#1f1f1f,stroke-width:3px,color:#ffffff
class D,F s_hot
style G fill:#f7f7f7,stroke:#b9b9b9,stroke-width:1.2px,color:#333333
style H fill:transparent,stroke:#1f1f1f,stroke-width:1.2px,color:#5d9cf0
linkStyle 0 stroke:#2b2b2b,stroke-width:1.3px,color:#2b2b2b
linkStyle 1 stroke:#2b2b2b,stroke-width:1.3px,color:#2b2b2b,stroke-dasharray:6 4
linkStyle 2 stroke:#2b2b2b,stroke-width:2.4px,color:#2b2b2b
linkStyle 3 stroke:#14a89e,stroke-width:1.3px,color:#14a89e
linkStyle 4 stroke:#ff9b3d,stroke-width:3px,color:#dcd6fb,stroke-dasharray:6 3
"
`;

