exports[`canvas.layout "legacy" > shop-domains-er.mmdx × default-light 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" viewBox="24 -28.8 1971.2 420" width="1971.2" height="420" role="img" aria-label="Online shop data model"><title>Online shop data model</title><desc>Customers, orders and payments in the sales domain; products and stock in the catalog domain</desc><defs></defs><rect class="page" x="24" y="-28.8" width="1971.2" height="420" fill="transparent"/><g class="title" data-part="title"><text text-anchor="middle" dominant-baseline="central" font-family="Roboto, &#39;Segoe UI&#39;, &#39;Helvetica Neue&#39;, Arial, sans-serif" font-size="22" font-weight="600" fill="#333333"><tspan x="1009.6" y="31.7">Online shop by domain</tspan></text></g><g class="el group" data-kind="group" data-id="Sales"><rect x="60" y="60" width="1069" height="285" rx="12" fill="#f7f7f7" stroke="#b9b9b9" stroke-width="1.2"/><text text-anchor="middle" dominant-baseline="central" font-family="Roboto, &#39;Segoe UI&#39;, &#39;Helvetica Neue&#39;, Arial, sans-serif" font-size="14" font-weight="600" fill="#333333"><tspan x="594.5" y="77">Sales domain</tspan></text></g><g class="el group" data-kind="group" data-id="Catalog"><rect x="1516.4" y="142.6" width="442.8" height="120.5" rx="12" fill="#f7f7f7" stroke="#b9b9b9" stroke-width="1.2"/><text text-anchor="middle" dominant-baseline="central" font-family="Roboto, &#39;Segoe UI&#39;, &#39;Helvetica Neue&#39;, Arial, sans-serif" font-size="14" font-weight="600" fill="#333333"><tspan x="1737.8" y="159.6">Catalog domain</tspan></text></g><g class="el group" data-kind="group" data-id="Billing"><rect x="646.3" y="151.3" width="468.6" height="120.5" rx="12" fill="#f7f7f7" stroke="#b9b9b9" stroke-width="1.2"/><text text-anchor="middle" dominant-baseline="central" font-family="Roboto, &#39;Segoe UI&#39;, &#39;Helvetica Neue&#39;, Arial, sans-serif" font-size="14" font-weight="600" fill="#333333"><tspan x="880.7" y="168.3">Billing</tspan></text></g><g clas