flowchart TB
  web["Web"]:::client
  mobile["Mobile"]:::client
  gw["① API Gateway"]:::gateway
  reg["② Service Registry"]:::core
  subgraph svc ["③ Service Layer"]
    svcA["Service A"]:::api
    svcB["Service B"]:::api
    svcC["Service C"]:::api
  end
  admin(("Admin Access"))
  auth["④ Authorization Server"]:::security
  lb["Load Balancer (L7)"]
  cache[("⑥ Distributed Cache")]:::security
  subgraph db ["⑤ Database Layer"]
    db1[("Primary")]:::infra
    db2[("Replica")]:::infra
    db3[("Replica")]:::infra
  end
  msg["⑦ Distributed Messaging"]:::event-bus
  queueUi["Queue Management Interface"]:::service
  subgraph mon ["⑧ Monitoring"]
    prom["Prometheus"]:::metrics
    grafana["Grafana"]:::metrics
  end
  mviz(["Metrics Visualization"]):::storage
  subgraph elk ["⑨ Logging — ELK"]
    logstash["Logstash"]:::analytics
    es["Elasticsearch"]:::analytics
    kibana["Kibana"]:::analytics
  end
  lviz(["Logs Visualization"]):::storage
  tracing["⑩ Tracing — Jaeger"]:::metrics

  web --> gw
  mobile --> gw
  gw --> reg
  gw --> svcA
  gw --> svcB
  gw --> svcC
  admin --> auth
  auth --> svc
  svcA -.-> msg
  svcB -.-> msg
  svcC -.-> msg
  queueUi --> msg
  svcA --> lb
  svcB --> lb
  svcC --> lb
  lb --> cache
  lb --> db1
  db1 ---|"replication"| db2
  db1 -.- db3
  db2 --- db3
  svc -->|"metrics"| prom
  prom --> grafana
  mviz --> grafana
  svc -->|"logs"| logstash
  auth --> logstash
  logstash --> es
  es --> kibana
  lviz --> kibana
  svc -->|"traces"| tracing

