flowchart LR
  subgraph fusion ["Fusion Services"]
    gw["API Gateway"]:::gateway
    subgraph query ["Querying Services"]
      qp{{"Query Pipelines"}}:::api
      primary[("primary collection")]:::storage
      qrw[("query_rewrite collection")]:::storage
      sigAggr[("signals_aggr collection")]:::storage
    end
    subgraph mon ["Monitoring Services"]
      promg["Prometheus / Grafana"]:::metrics
    end
    subgraph index ["Indexing Services"]
      jl{{"Job Launcher"}}:::api
      jrs{{"Job Rest Server"}}:::api
      conn{{"Connectors"}}:::api
      spark{{"Spark"}}:::api
      ip{{"Index Pipelines"}}:::api
      kafka["Kafka"]:::event-bus
      signals[("signals collection")]:::storage
      jobRep[("job reports collection")]:::storage
      qrwStaging[("query_rewrite_staging collection")]:::storage
    end
    subgraph util ["Utility Services"]
      adminSvc{{"Admin Service"}}:::core
      zk{{"Zookeeper"}}:::core
      cfg{{"ConfigSync"}}:::core
      blobs[("system_blobs collection")]:::storage
      ui{{"UI Services"}}:::ui
      ml{{"ML Service"}}:::analytics
      adminUi["Admin UI"]:::ui
      pmUi["PM UI"]:::ui
      rulesUi["Rules UI"]:::ui
    end
  end
  subgraph ext ["External"]
    git["Git repository (GitLab)"]:::external
  end

  gw -->|"Routes requests from Ingress"| qp
  gw --> ip
  qp -->|"Solr queries"| primary
  qp --> qrw
  qp --> sigAggr
  query --> mon
  index --> mon
  jl --> jrs
  jrs --> conn
  jrs --> spark
  conn --> ip
  spark --> ip
  ip --> kafka
  kafka -->|"Signals"| signals
  adminSvc --> zk
  zk --> cfg
  cfg -->|"Config updates"| git
  ui --> adminUi
  ui --> pmUi
  ui --> rulesUi

