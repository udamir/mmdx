flowchart TB
  web["Web"]:::client
  desktop["Desktop"]:::client
  mobile["Mobile"]:::client
  gw["① API Gateway"]:::gateway
  reg["② Service Registry"]:::core
  subgraph svc ["③ Service Layer"]
    svcA["Service A"]:::api
    svcB["Service B"]:::api
    svcC["Service C"]:::api
  end
  admin(("Admin Access"))
  auth["④ Authorization Server"]:::ui
  lb["Load Balancer"]
  cache[("⑥ Distributed Cache")]:::security
  subgraph db ["⑤ Database Layer"]
    db1[("Primary Core")]:::infra
    db2[("Replica")]:::infra
    db3[("Replica")]:::infra
    n1["Reports store"]
  end
  msg["⑦ Distributed Messaging"]:::event-bus
  queue["Queue Management Interface"]:::service
  subgraph mon ["⑧ Monitoring"]
    prom["Prometheus"]:::metrics
    grafana["Grafana"]:::metrics
  end
  mviz(["Metrics Visualization"]):::storage
  subgraph elk ["⑨ Logging — ELK"]
    logstash["Logstash"]:::analytics
    es["Elasticsearch"]:::analytics
    kibana["Kibana"]:::analytics
  end
  lviz(["Logs Visualization"]):::storage

  web --> gw
  desktop --> gw
  mobile --> gw
  gw --> reg
  gw --> svcA
  gw --> svcB
  gw --> svcC
  admin --> auth
  auth --> svc
  svcA -.-> msg
  svcB -.-> msg
  svcC -.-> msg
  queue --> msg
  svcA --> lb
  svcB --> lb
  svcC --> lb
  lb --> cache
  lb --> db1
  db1 ---|"replication"| db2
  db1 --- db3
  db2 --- db3
  svc -->|"metrics"| prom
  prom --> grafana
  mviz --> grafana
  svc -->|"logs"| logstash
  auth --> logstash
  logstash --> es
  es --> kibana
  lviz --> kibana
  db3 --> n1

