flowchart TB
  subgraph appArch ["Application architecture"]
    mono["Monolithic<br>architecture v2"]:::pattern
    micro["Microservice<br/>architecture"]:::pattern
    n6[("Backup API")]
  end
  subgraph decomp ["Decomposition"]
    dbc["Internal Decompose by<br>business capability"]:::pattern
    dsd["Decompose<br/>by subdomain"]:::pattern
    scs["Self-contained<br/>Service"]:::pattern
    spt["Service per team"]:::pattern
  end
  subgraph data ["Data patterns"]
    subgraph dbArch ["Database architecture"]
    end
    subgraph querying ["Querying"]
      apic["API Composition"]:::pattern
      cqrs["CQRS"]:::pattern
    end
    subgraph consistency ["Maintaining data consistency"]
      aggregate["Aggregate Internal"]:::pattern
      saga["Saga"]:::pattern
      evsrc["Event sourcing"]:::pattern
      devent["Domain event"]:::pattern
    end
  end
  subgraph testing ["Testing"]
    cdct["Consumer-driven<br/>contract test"]:::pattern
    csct["Legacy test"]:::pattern
    sct["Service<br/>Component Test"]:::pattern
  end
  subgraph uiPat ["UI"]
    csuc["Client-side<br/>UI composition"]:::pattern
    n4(["Notifications store"])
  end
  subgraph cross ["Cross-cutting concerns"]
    chassis["Microservice<br/>Chassis"]:::pattern
    extcfg["Externalized<br/>configuration"]:::pattern
    n1(["Audit store"])
  end
  subgraph security ["Security"]
    token["Access Token"]:::pattern
  end
  subgraph comm ["Communication patterns"]
    subgraph commStyle ["Communication style"]
      rpi["Remote Procedure<br/>Invocation"]:::pattern
      messaging["Messaging Public"]:::pattern
      dsp["Domain-specific"]:::pattern
      n5[("Scheduler store")]
    end
    subgraph txMsg ["Transactional messaging"]
      outbox["Transactional<br/>Outbox"]:::pattern
      tlt["Transaction<br/>log tailing"]:::pattern
      pp["Polling<br/>publisher"]:::pattern
    end
    subgraph reliability ["Reliability"]
      cb["Circuit Breaker"]:::pattern
    end
    subgraph msgGroup ["Messaging "]
      idem["Idempotent<br/>Consumer"]:::pattern
    end
    subgraph extApi ["External API"]
      apigw["API gateway"]:::pattern
      bff["Backends for<br/>frontends"]:::pattern
      n3[("Backup API")]
    end
    subgraph discovery ["Discovery"]
      csd["Client-side<br/>discovery"]:::pattern
      selfreg["Self<br/>registration"]:::pattern
      registry["Service registry"]:::pattern
      ssd["Server-side<br/>discovery"]:::pattern
      tpr["Core 3rd party<br>registration"]:::pattern
    end
  end
  subgraph observability ["Observability"]
    audit["Audit logging Public"]:::pattern
    appMetrics["Application<br/>metrics"]:::pattern
    dtracing["Distributed<br>tracing Core"]:::pattern
    health["Health check API"]:::pattern
    excTrack["Exception<br/>tracking"]:::pattern
    logAgg["Log aggregation"]:::pattern
    logDeploy["Log deployments<br/>and changes"]:::pattern
    n7(["Backup worker"])
  end
  subgraph deploy ["Deployment"]
    serverless["Serverless<br/>deployment"]:::pattern
    ssph["Single Service<br/>per Host"]:::pattern
    msph["Multiple<br/>Services per host"]:::pattern
    spc["Service-per-Container"]:::pattern
    spvm["Service-per-VM"]:::pattern
    sidecar["Sidecar"]:::pattern
    mesh["Service mesh"]:::pattern
    n2[("Billing store")]
  end

  mono <-.-> micro
  micro --> decomp
  dbc <-.-> dsd
  apic <-.-> cqrs
  cqrs --> devent
  saga --> aggregate
  devent --> aggregate
  evsrc --> aggregate
  devent --> evsrc
  saga --> messaging
  devent --> messaging
  devent -->|"HTTPS"| outbox
  evsrc <-.-> outbox
  rpi <-.->|"sync"| messaging
  rpi <-.-> dsp
  messaging <-.-> dsp
  messaging --> outbox
  outbox --> tlt
  outbox --> pp
  rpi --> cb
  apigw <-.-> bff
  csd <-.-> ssd
  selfreg <-.->|"writes"| tpr
  csd --> registry
  registry --> selfreg
  ssd --> registry
  registry --> tpr
  ssph -.-> serverless
  ssph <-.-> msph
  spc --> ssph
  spvm --> ssph
  spc <-.-> spvm
  chassis --> n1
  spc --> n2
  bff --> n3
  csuc --> n4
  messaging --> n5
  micro --> n6
  audit --> n7
  logDeploy --> apic
  n2 --> tlt
  apigw --> cqrs
  token --> evsrc

