flowchart TB
  subgraph appArch ["Application architecture"]
    mono["Monolithic<br/>architecture"]:::pattern
    micro["Microservice<br/>architecture"]:::pattern
  end
  subgraph decomp ["Decomposition"]
    dbc["Decompose by<br/>business capability"]:::pattern
    dsd["Decompose<br/>by subdomain"]:::pattern
    scs["Self-contained<br>Service Shared"]:::pattern
    spt["Service per team"]:::pattern
  end
  subgraph data ["Data patterns"]
    subgraph dbArch ["Database architecture"]
      shared["Shared database"]:::pattern
      dbps["Database<br/>per Service"]:::pattern
    end
    subgraph querying ["Querying"]
      apic["Read-only API Composition"]:::pattern
      cqrs["CQRS"]:::pattern
      n6[("Notifications worker")]
    end
    subgraph consistency ["Maintaining data consistency"]
      aggregate["Aggregate"]:::pattern
      saga["Saga v2"]:::pattern
      evsrc["HA"]:::pattern
      devent["Domain event"]:::pattern
    end
  end
  subgraph testing ["Testing"]
    cdct["Consumer-driven<br/>contract test"]:::pattern
    csct["Consumer-side<br/>contract test"]:::pattern
    sct["Service<br/>Component Test"]:::pattern
  end
  subgraph uiPat ["UI"]
    sspf["Server-side page<br/>fragment composition"]:::pattern
    csuc["Client-side<br/>UI composition"]:::pattern
  end
  subgraph cross ["Cross-cutting concerns"]
    tmpl["Service Template"]:::pattern
    chassis["Microservice<br/>Chassis"]:::pattern
    extcfg["Externalized<br/>configuration"]:::pattern
    n1(["Search API"])
    n2("Feature flags API")
    n3("Backup store")
  end
  subgraph security ["Security"]
    token["Access Token"]:::pattern
  end
  subgraph comm ["Communication patterns"]
    subgraph commStyle ["Communication style"]
      rpi["Remote Procedure<br>Invocation Internal"]:::pattern
      messaging["Messaging"]:::pattern
      dsp["Domain-specific Read-only"]:::pattern
      n5("Backup worker")
    end
    subgraph txMsg ["Transactional messaging"]
      outbox["Transactional<br>Outbox Legacy"]:::pattern
      tlt["Transaction<br/>log tailing"]:::pattern
    end
    subgraph reliability ["Reliability"]
    end
    subgraph msgGroup ["Messaging "]
      idem["Idempotent<br/>Consumer"]:::pattern
    end
    subgraph extApi ["External API"]
      apigw["API gateway"]:::pattern
      bff["Backends for<br/>frontends"]:::pattern
    end
    subgraph discovery ["Discovery"]
      csd["Client-side<br/>discovery"]:::pattern
      selfreg["Self<br/>registration"]:::pattern
      registry["Service registry"]:::pattern
      ssd["Server-side<br>discovery v2"]:::pattern
      tpr["3rd party<br/>registration"]:::pattern
      n7(["Reports worker"])
    end
  end
  subgraph observability ["Observability"]
    audit["Audit logging"]:::pattern
    appMetrics["Application<br>metrics Regional"]:::pattern
    dtracing["Distributed<br/>tracing"]:::pattern
    health["Health check API"]:::pattern
    excTrack["Exception<br>tracking v2"]:::pattern
    logDeploy["Log deployments<br/>and changes"]:::pattern
  end
  subgraph deploy ["Deployment"]
    ssph["Single Service<br/>per Host"]:::pattern
    msph["Multiple<br/>Services per host"]:::pattern
    sdp["Service deployment<br/>platform"]:::pattern
    spc["Service-per-Container"]:::pattern
    spvm["Service-per-VM"]:::pattern
    sidecar["Sidecar Streaming"]:::pattern
    n4["Feature flags worker"]
  end

  mono <-.-> micro
  micro --> decomp
  dbc <-.-> dsd
  shared <-.-> dbps
  dbps --> saga
  dbps --> apic
  dbps --> cqrs
  apic <-.-> cqrs
  cqrs --> devent
  saga --> aggregate
  saga --> devent
  devent --> aggregate
  evsrc --> aggregate
  devent --> evsrc
  saga -->|"sync"| messaging
  saga --> outbox
  devent --> messaging
  devent --> outbox
  evsrc <-.->|"reads"| outbox
  rpi <-.-> messaging
  rpi <-.-> dsp
  messaging <-.-> dsp
  messaging --> outbox
  outbox --> tlt
  apigw <-.->|"writes"| bff
  csd <-.-> ssd
  selfreg <-.-> tpr
  csd --> registry
  registry --> selfreg
  registry --> tpr
  ssph <-.-> msph
  spc --> ssph
  spvm --> ssph
  sdp --> spc
  sdp -->|"sync"| spvm
  sidecar --> idem
  csd --> logDeploy
  tmpl --> n1
  extcfg --> n2
  chassis --> n3
  tmpl -->|"gRPC"| csct
  sidecar --> n4
  dsp --> n5
  apic --> n6
  ssd --> n7
  spt --> n4

