sequenceDiagram
  box Microservice Management Provider
    participant init as Initializer
    participant env as Environment initializer
    participant net as Network initializer Streaming
    participant vol as Volume initializer
    participant svc as Service initializer
    participant repo as Repository
    participant rdc as Remote Docker Client
  end
  box Edge Computing Platform
    participant docker as Docker Engine
  end

  activate init
  init->>init: Read-only Read microservices description file
  activate env
  init-)-env: Parsing environment
  env->>env: Parsing environment from description file
  env->>repo: Save Regional to Repository
  deactivate env

  loop Networks
    activate net
    init-)net: Parsing network
    net->>net: Parsing network from description file
    net->>repo: Save network to Repository
    activate rdc
    activate docker
    deactivate net
  Note over rdc: TODO: batch this
    docker--)rdc: Response with json
    deactivate docker
    opt response code > 200
      activate docker
      rdc->>docker: POST Request to create a network
      docker--)rdc: with json
      deactivate docker
    end
    deactivate rdc
  end

  loop Volumes
    activate vol
    init-)vol: Parsing volume
    env->>rdc: Write audit record
  Note over init: TODO: batch this
    vol->>vol: Parsing volume from description file
    vol->>repo: Save volume to Repository
    activate rdc
    vol->>rdc: Invoke create volume function by name
    deactivate vol
    activate docker
    rdc-)docker: GET Request to inspect volume by name
    docker--)rdc: Response with json
    deactivate docker
    opt response code > 200
      activate docker
      rdc->>docker: POST Request to create a volume
      docker--)rdc: Response with json
      deactivate docker
      deactivate rdc
    end
  end

  loop Services
    activate svc
    init-)svc: Parsing service
    svc->>svc: Shared Parsing service from description file
    svc->>repo: Save service to Repository
    svc->>init: Acknowledge
    activate rdc
    svc->>rdc: Invoke create service function by name
    activate docker
    deactivate svc
    rdc-)docker: GET Request to inspect container by name
    svc->>rdc: Write audit record
    docker--)rdc: Response with json
    deactivate docker
    opt response code > 200
      rdc->>+docker: POST Request to create a container
      docker--)rdc: Response with json
      deactivate docker
      deactivate rdc
    end
  end

