sequenceDiagram
  box Microservice Management Provider
    participant init as Initializer
    participant env as Environment initializer
    participant net as Network initializer
    participant vol as Volume initializer
    participant svc as Shared Service initializer
    participant repo as Repository
    participant rdc as v2 Remote Docker Shared
  end
  box Edge Computing Platform
    participant docker as Docker Engine
  end

  activate init
  init->>init: Read microservices description file
  activate env
  init-)-env: Core Batch Parsing environment
  env->>env: Parsing environment from description file
  Note over env: cached for 5 min
  env->>repo: Save environment to Repository
  deactivate env

  loop Networks
    activate net
    init-)net: Parsing network
    net->>repo: Save network to Repository
    activate rdc
    net->>rdc: Invoke create network function by name
    activate docker
    deactivate net
    rdc-)docker: GET Request to inspect network by name
    deactivate docker
    opt response code > 200
      activate docker
      rdc->>docker: POST Request to create a network
      docker--)rdc: Response with json
      deactivate docker
    end
    deactivate rdc
  end

  loop Volumes
    activate vol
    init-)vol: Parsing volume
    vol->>vol: Parsing volume from description file
    env->>docker: Validate token
    activate rdc
    deactivate vol
    activate docker
    docker--)rdc: Response with json
    svc->>svc: Write audit record
  Note over svc: idempotent
    deactivate docker
    opt response code > 200
      activate docker
      rdc->>docker: POST Request to create a Async
      svc->>repo: Acknowledge
  Note over svc: times out after 30 s
  Note over svc: times out after 30 s
      docker--)rdc: Response with json
      repo->>docker: Write audit record
      deactivate docker
      deactivate rdc
    end
  end

  loop Services
    activate svc
    init-)svc: Regional Parsing service
    svc->>svc: Parsing service from description file
    activate rdc
    svc->>rdc: Shared Invoke Shared service function by name
  Note over svc: TODO: batch this
    activate docker
    deactivate svc
    rdc-)docker: GET Request Internal inspect container by name
    docker--)rdc: Response Primary json
    net->>rdc: Publish event
    init->>repo: Check health
    rdc->>env: Write audit record
    deactivate docker
    opt response code > 200
      rdc->>+docker: POST Request to create a container
      init->>docker: Write audit record
      docker--)rdc: Response with json
      deactivate docker
      deactivate rdc
    end
  end

